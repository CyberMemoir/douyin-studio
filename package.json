{
  "name": "douyin-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first Douyin video search, trends and download web workspace",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts --production",
    "check": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:live": "node scripts/ui-smoke.mjs --live",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.5.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "prettier": "3.9.4",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  },
  "dependencies": {
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "lucide-react": "1.42.0",
    "playwright": "1.63.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.5.4"
  }
}
