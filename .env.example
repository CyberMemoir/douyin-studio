# The app listens on loopback only.
PORT=4321
# Optional: attach to an existing dedicated automation Chrome (local CDP only).
# DOUYIN_CDP_URL=http://127.0.0.1:9421
# Optional: dedicated persistent browser directory; never use your daily Chrome profile.
# DOUYIN_PROFILE_DIR=/absolute/path/to/automation-profile
# Optional: use a specific Chrome/Chromium executable.
# DOUYIN_BROWSER_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# Local runtime data; ignored by git by default.
# DOUYIN_DATA_DIR=.data
# Optional: local failed-page diagnostics (may contain visible account/post text).
# Keep this directory private and out of Git. Request query strings and Cookies are not recorded.
# DOUYIN_DIAGNOSTICS_DIR=/absolute/path/to/private-diagnostics

# Server collection after normal account setup; does not bypass login or verification.
# DOUYIN_HEADLESS=true
